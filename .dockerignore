# Зависимости ставятся внутри образа: хостовые версии собраны под Windows
# и в Linux-контейнере нерабочие.
backend/vendor/
frontend/node_modules/
frontend/dist/

# Кэш и логи Symfony — генерируются entrypoint'ом на старте.
backend/var/

# Локальные переменные окружения не должны попадать в образ:
# в проде значения приходят из настроек Render.
backend/.env.local
backend/.env.*.local

# Ключи JWT: пара генерируется entrypoint'ом из JWT_PASSPHRASE при старте.
# Попав в образ, локальные ключи подменяют собой эту генерацию — entrypoint
# видит готовый файл и пропускает шаг, а подписаны они другим паролем, и
# вход в приложение падает с 500.
backend/config/jwt/

# Не нужно в образе.
.git/
.idea/
.vscode/
*.md
project_requirements*.txt
docker-compose.yml
